{
  "name": "insidir-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Insidir Terminal: a live scanner for mispriced markets on Polymarket and Kalshi, using pure math.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx worker/index.ts",
    "scan": "tsx scripts/scan.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:endpoints": "tsx scripts/check-endpoints.ts"
  },
  "dependencies": {
    "@whop/elements": "1.9.0",
    "@whop/elements-react": "1.9.0",
    "@whop/sdk": "2.6.0",
    "drizzle-orm": "^0.44.7",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "lighthouse": "^12.8.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
