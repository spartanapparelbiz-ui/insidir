# Insidir Terminal. Copy to .env.local for development; set the same names as Railway variables in production.
# Both Railway services (web and worker) read the same set unless noted.

# --- Core -----------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://insidir:insidir@localhost:5432/terminal_dev
# Optional pool size per process (default 10)
DATABASE_POOL_MAX=
# Public HTTPS origin, no trailing slash. Used for the Whop OAuth redirect, the after-checkout redirect, alert and unsubscribe links.
APP_URL=https://insidir.com

# --- Whop: sign-in, billing, access (web and worker) ------------------------------------------------------
# One switch: sandbox (the default; anything but exactly "production") or production. Each environment has its own
# full set below, so both can stay in Railway and flipping WHOP_ENV is the only change. See lib/whop/config.ts.
WHOP_ENV=sandbox
# Sandbox: sandbox.whop.com → Dashboard → Developer. Products and plans: npx tsx scripts/whop-setup.ts
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_COMPANY_ID=
WHOP_SANDBOX_CLIENT_ID=
WHOP_SANDBOX_CLIENT_SECRET=
WHOP_SANDBOX_WEBHOOK_SECRET=
WHOP_SANDBOX_PRODUCT_INSIDIR=
WHOP_SANDBOX_PRODUCT_PRO=
WHOP_SANDBOX_PLAN_INSIDIR=
WHOP_SANDBOX_PLAN_PRO=
# Production: whop.com → Dashboard → Developer. Never created by code without the owner (docs/WHOP-LAUNCH.md).
# Account API key, server only: users.checkAccess, memberships, checkout configurations
WHOP_API_KEY=
WHOP_COMPANY_ID=
# OAuth app (app_…); redirect URI https://YOUR_DOMAIN/auth/callback; scopes openid profile email
WHOP_CLIENT_ID=
# Optional: sent on the token exchange when set
WHOP_CLIENT_SECRET=
# Signing secret (ws_…) of the webhook pointed at https://YOUR_DOMAIN/api/webhooks/whop
WHOP_WEBHOOK_SECRET=
# Product ids (prod_…) whose access grants each plan; plan ids (plan_…) sold at checkout
WHOP_PRODUCT_INSIDIR=
WHOP_PRODUCT_PRO=
WHOP_PLAN_INSIDIR=
WHOP_PLAN_PRO=
# Who gets a dispute alert the moment one opens (required; a dispute webhook is retried until it is set)
WHOP_ALERT_EMAIL=
# Embed Whop's Checkout element on /pricing (default: on in production, off in the sandbox, where Elements isn't
# generally available yet). 0 sends buyers to a checkout configuration's purchase_url instead.
WHOP_EMBED_CHECKOUT=
# "Refer and earn" in Settings. Turn on only after the affiliate program is on in Whop, with the same rates.
WHOP_AFFILIATES_ENABLED=0
WHOP_AFFILIATE_MEMBER_PERCENT=50
WHOP_AFFILIATE_GLOBAL_PERCENT=30

# --- Alerts ----------------------------------------------------------------------------------------------
# Web push (VAPID). Generate once: npx web-push generate-vapid-keys. Never rotate without re-subscribing devices.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@insidir.com
# Email through Resend (free tier: 3,000/month, 100/day): backup alerts, daily summaries, failed-payment notices and
# dispute alerts. Nothing is emailed without it.
RESEND_API_KEY=
EMAIL_FROM=Insidir <alerts@insidir.com>
# 32+ random characters; signs the one-click unsubscribe links (openssl rand -hex 32)
EMAIL_UNSUBSCRIBE_SECRET=

# --- Matching (worker) -----------------------------------------------------------------------------------
# Optional. Without a key, unsure Kalshi ↔ Polymarket pairs are simply left unmatched.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Hard monthly cap on LLM spend, USD
MATCH_LLM_MONTHLY_USD=10
# Tuning (defaults shown)
MATCH_MAX_CLOSE_GAP_HOURS=48
MATCH_AUTO_ACCEPT=0.85
MATCH_LLM_MIN=0.6
MATCH_LLM_MAX_PER_RUN=1000
MATCH_LLM_MAX_PER_MARKET=2
MATCH_LLM_CONCURRENCY=4
MATCH_MAX_CANDIDATES=5

# --- Admin (/admin) --------------------------------------------------------------------------------------
# Both are required: a 32+ character token AND a 6-digit code from an authenticator app (base32 secret).
ADMIN_TOKEN=
ADMIN_TOTP_SECRET=

# --- Venues (worker) -------------------------------------------------------------------------------------
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Polymarket US: endpoints are unverified; the client fails soft (no markets) if they are wrong. On unless 0.
# `npm run check:endpoints` only fails on it when this is exactly 1.
POLYMARKET_US_ENABLED=1
POLYMARKET_US_API_URL=https://api.polymarket.us
# Per-bucket request budgets (requests/second). Defaults sit at ~80% of each published limit.
KALSHI_RATE_PER_SEC=
POLYMARKET_GAMMA_RATE_PER_SEC=
POLYMARKET_CLOB_RATE_PER_SEC=
POLYMARKET_DATA_RATE_PER_SEC=
POLYMARKET_US_RATE_PER_SEC=

# --- Worker cadence (ms; defaults shown) -----------------------------------------------------------------
SWEEP_MS=300000
SCAN_MS=5000
FULL_SCAN_MS=60000
ALERT_MS=5000
WHALE_MS=15000
SETTLE_MS=900000
# Stop the worker after this long (QA runs only)
WORKER_RUN_FOR_MS=
