# Required to ingest SEC filings: use a real business name and monitored contact email
SEC_USER_AGENT=Insidir Research contact@example.com
DATABASE_URL=postgresql://user:password@localhost:5432/insidir
PORT=8080
# Set origin to the actual Insidir front-end before exposing account endpoints
ALLOWED_ORIGINS=https://insidir-web-production.up.railway.app
# 1 enables automatic fifteen-minute ingestion in a single Railway service
AUTO_INGEST=0
# To allow secured manual/cron ingestion: use a long unpredictable secret
INGEST_SECRET=
# Production must use HTTPS; set to 1 behind Railway HTTPS proxy
COOKIE_SECURE=1
# Allows signup; set 0 until ready to accept accounts
ALLOW_SIGNUP=0
# Optional ingestion limits
SEC_MAX_FILINGS_PER_RUN=35
SEC_TIMEOUT_MS=15000
# Delayed prices on company pages (yahoo, or none to turn market data off)
MARKET_DATA_PROVIDER=yahoo

# Optional read-only SnapTrade OAuth app. Keep off until registered and tested with approved production access.
# The user links accounts in SnapTrade Personal; Insidir requests ONLY the 'read' permission.
BROKERAGE_CONNECT_ENABLED=0
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# Exact URI registered in SnapTrade OAuth Apps (HTTPS in production)
SNAPTRADE_OAUTH_REDIRECT_URI=https://your-insidir-domain.com/v1/me/brokerage/callback
# Generate a fresh 32-byte random key: openssl rand -hex 32. Never change without a rotation migration.
BROKERAGE_ENCRYPTION_KEY=
