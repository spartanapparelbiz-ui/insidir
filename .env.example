# Insidir Terminal. Copy to .env.local for development; set the same names as Railway variables in production.
# Both Railway services (web and worker) read the same set unless noted.

# --- Core -----------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://insidir:insidir@localhost:5432/terminal_dev
# Optional pool size per process (default 10)
DATABASE_POOL_MAX=
# Public HTTPS origin, no trailing slash. Used for the Whop redirect, alert links and unsubscribe links.
APP_URL=https://insidir.com

# --- Whop: sign-in and billing (web) ---------------------------------------------------------------------
WHOP_CLIENT_ID=
# Optional: sent on the token exchange when set
WHOP_CLIENT_SECRET=
# Account API key, server only: reads memberships and cancels them
WHOP_API_KEY=
WHOP_COMPANY_ID=
# Product ids (prod_…) that grant each plan
WHOP_PRODUCT_INSIDIR=
WHOP_PRODUCT_PRO=
# Plan ids (plan_…) used for the checkout links
WHOP_PLAN_INSIDIR=
WHOP_PLAN_PRO=
# Webhook signing secret (ws_…) for https://YOUR_DOMAIN/api/whop/webhook
WHOP_WEBHOOK_SECRET=

# --- Alerts ----------------------------------------------------------------------------------------------
# Web push (VAPID). Generate once: npx web-push generate-vapid-keys. Never rotate without re-subscribing devices.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@insidir.com
# Email backup and daily summaries through Resend (free tier: 3,000/month, 100/day). Nothing is emailed without it.
RESEND_API_KEY=
EMAIL_FROM=Insidir <alerts@insidir.com>
# 32+ random characters; signs the one-click unsubscribe links (openssl rand -hex 32)
EMAIL_UNSUBSCRIBE_SECRET=

# --- Matching (worker) -----------------------------------------------------------------------------------
# Optional. Without a key, unsure Kalshi ↔ Polymarket pairs are simply left unmatched.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Hard monthly cap on LLM spend, USD
MATCH_LLM_MONTHLY_USD=10
# Tuning (defaults shown)
MATCH_MAX_CLOSE_GAP_HOURS=48
MATCH_AUTO_ACCEPT=0.85
MATCH_LLM_MIN=0.6
MATCH_LLM_MAX_PER_RUN=1000
MATCH_LLM_MAX_PER_MARKET=2
MATCH_LLM_CONCURRENCY=4
MATCH_MAX_CANDIDATES=5

# --- Admin (/admin) --------------------------------------------------------------------------------------
# Both are required: a 32+ character token AND a 6-digit code from an authenticator app (base32 secret).
ADMIN_TOKEN=
ADMIN_TOTP_SECRET=

# --- Venues (worker) -------------------------------------------------------------------------------------
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Polymarket US: endpoints are unverified; the client fails soft (no markets) if they are wrong. On unless 0.
# `npm run check:endpoints` only fails on it when this is exactly 1.
POLYMARKET_US_ENABLED=1
POLYMARKET_US_API_URL=https://api.polymarket.us
# Per-bucket request budgets (requests/second). Defaults sit at ~80% of each published limit.
KALSHI_RATE_PER_SEC=
POLYMARKET_GAMMA_RATE_PER_SEC=
POLYMARKET_CLOB_RATE_PER_SEC=
POLYMARKET_DATA_RATE_PER_SEC=
POLYMARKET_US_RATE_PER_SEC=

# --- Scan scope and safety (both services read LADDERS_ENABLED) -------------------------------------------
# Ladder deals are off until their subject matching is rebuilt and 50 have been hand-checked. 1 turns them on.
LADDERS_ENABLED=0
# Beyond matched pairs, books are fetched only for markets with at least this 24h volume (contracts on Kalshi,
# dollars on Polymarket) that close within BOOK_MAX_DAYS. Defaults shown.
BOOK_MIN_VOLUME_24H=1000
BOOK_MAX_DAYS=30
# Heap of the worker's match thread, MB (the main thread's is set in package.json "worker")
MATCH_THREAD_HEAP_MB=3072

# --- Worker cadence (ms; defaults shown) -----------------------------------------------------------------
SWEEP_MS=300000
SCAN_MS=5000
FULL_SCAN_MS=60000
# Threshold ladders: off unless 1 (production runs with 0)
LADDERS_ENABLED=0
# V2 readiness (docs/V2.md "Coming soon rule"): features listed here are live; the rest show a Coming soon badge.
# Keys: feed, records, follows, alerts_push, alerts_email, daily_email, custom_rules, price_gaps (crypto, stocks: never yet).
FEATURES_READY=feed,records,follows
# Emails (the Whop account email) allowed to open /admin/posts.
POSTS_ADMIN_EMAILS=
ALERT_MS=5000
WHALE_MS=15000
SETTLE_MS=900000
# Stop the worker after this long (QA runs only)
WORKER_RUN_FOR_MS=

# Big money moves (docs/V2.md)
WHALE_MIN_POLY=10000
WHALE_MIN_KALSHI=5000
# Polymarket fills read for merging (a move is merged from fills of at least this many dollars)
WHALE_FILL_MIN=500
MOVES_MS=15000
