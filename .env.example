# Required to ingest SEC filings: use a real business name and monitored contact email
SEC_USER_AGENT=Insidir Research contact@example.com
DATABASE_URL=postgresql://user:password@localhost:5432/insidir
PORT=8080
# Set origin to the actual Insidir front-end before exposing account endpoints
ALLOWED_ORIGINS=https://insidir-web-production.up.railway.app
# 1 enables automatic fifteen-minute ingestion in a single Railway service
AUTO_INGEST=0
# To allow secured manual/cron ingestion: use a long unpredictable secret
INGEST_SECRET=
# Production must use HTTPS; set to 1 behind Railway HTTPS proxy
COOKIE_SECURE=1
# Allows signup. With the hard paywall people must create an account before they can
# subscribe, so set 1 in production once Stripe billing (below) is configured.
ALLOW_SIGNUP=0
# Optional ingestion limits
SEC_MAX_FILINGS_PER_RUN=35
SEC_TIMEOUT_MS=15000
# Delayed prices on company pages (yahoo, or none to turn market data off)
MARKET_DATA_PROVIDER=yahoo

# Optional read-only SnapTrade OAuth app. Keep off until registered and tested with approved production access.
# The user links accounts in SnapTrade Personal; Insidir requests ONLY the 'read' permission.
BROKERAGE_CONNECT_ENABLED=0
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# Exact URI registered in SnapTrade OAuth Apps (HTTPS in production)
SNAPTRADE_OAUTH_REDIRECT_URI=https://your-insidir-domain.com/v1/me/brokerage/callback
# Generate a fresh 32-byte random key: openssl rand -hex 32. Never change without a rotation migration.
BROKERAGE_ENCRYPTION_KEY=

# --- Hard paywall and billing -------------------------------------------------------
# Insidir has NO free tier. New accounts start with a paid trial ($1 for 7 days, then $39 a
# month; INSIDIR_TRIAL, INSIDIR_TRIAL_DAYS, INSIDIR_TRIAL_FEE_CENTS below). The product (dashboard, research desk,
# companies and company reports, filings, people, watchlist, portfolio, alerts and every
# /v1 API behind them) needs a signed-in account with an active subscription
# (Stripe status active or trialing) or a complimentary email listed below.
# (Signed-in accounts without one can still delete their own saved items and revoke a
# brokerage grant.)
# With the paywall on and billing NOT configured, nobody except complimentary
# accounts can use the product, and nobody can subscribe.
#
# On unless exactly 0. INSIDIR_PAYWALL=0 opens the whole product to everyone:
# local development only, never in production.
INSIDIR_PAYWALL=1
# Owner/team accounts that use the product without paying. Comma-separated; case and
# spaces are ignored. There is no email verification, so register these accounts
# yourself BEFORE listing them (otherwise someone else could sign up with the address).
INSIDIR_COMPLIMENTARY_EMAILS=
# Stripe checkout for Insidir Pro ($39/month). Checkout and the customer portal only work
# when this is 1 AND the secret key, price ID and webhook secret are all set.
INSIDIR_BILLING_ENABLED=0
# Stripe secret API key (sk_live_... in production). Also used when a member deletes their
# account: Insidir expires the customer's open checkouts and cancels EVERY subscription that
# can still bill before deleting anything, and refuses (503) if Stripe cannot confirm it.
# Keep it set while any Stripe customer exists, or those accounts cannot be deleted.
INSIDIR_STRIPE_SECRET_KEY=
# The recurring $39/month Price (price_...). Only subscriptions to this exact Price grant access.
INSIDIR_STRIPE_PRICE_ID=
# Signing secret (whsec_...) of the webhook endpoint https://YOUR_DOMAIN/v1/billing/webhook.
# Send: checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, customer.subscription.paused, customer.subscription.resumed.
INSIDIR_STRIPE_WEBHOOK_SECRET=
# Public HTTPS origin of this site. Checkout returns to /billing.html?checkout=success
# (paid) or /subscribe.html?checkout=cancel; billing requests must come from this origin.
INSIDIR_PUBLIC_URL=https://insidir-web-production.up.railway.app

# Opt-in Web Push for iPhone Home Screen apps, Android and desktop
# Generate a stable VAPID pair (never rotate without re-registering devices).
INSIDIR_VAPID_PUBLIC_KEY=
INSIDIR_VAPID_PRIVATE_KEY=
INSIDIR_PUSH_CONTACT=mailto:hello@aethric.llc
# --- Insidir Intelligence: AI summaries (optional) ---------------------------------
# Source-backed summaries only, generated once per source version and shared by every member, verified
# against the cited records before display. Without a key every Intelligence feature still works from
# SEC records; only the "plain-English" summaries are off. The key never reaches the browser.
INSIDIR_OPENROUTER_API_KEY=
# Inexpensive model for single-source explanations (INSIDIR_OPENROUTER_MODEL is still read as a fallback)
INSIDIR_AI_MODEL_FAST=openai/gpt-4.1-nano
# Stronger model, used only for multi-company or multi-person research syntheses
INSIDIR_AI_MODEL_DEEP=openai/gpt-4.1-mini
# Limits (calls). Global caps cover all members; per-member caps stop one account using the budget.
INSIDIR_AI_HOURLY_LIMIT=40
INSIDIR_AI_DAILY_LIMIT=300
INSIDIR_AI_USER_HOURLY_LIMIT=12
INSIDIR_AI_USER_DAILY_LIMIT=40
# Spend caps in USD, summed from provider-reported cost (or list-price estimates when none is reported)
INSIDIR_AI_DAILY_BUDGET_USD=2
INSIDIR_AI_MONTHLY_BUDGET_USD=25
# Request bounds
INSIDIR_AI_MAX_INPUT_CHARS=12000
INSIDIR_AI_MAX_OUTPUT_TOKENS=450
INSIDIR_AI_TIMEOUT_MS=15000
INSIDIR_AI_RETRIES=1
# Optional list prices for estimates, JSON {"provider/model":[input_usd_per_mtok,output_usd_per_mtok]}
INSIDIR_AI_PRICES=
# 0-5: prewarm summaries for this many recent filings per run (0 = on demand only)
INSIDIR_AI_BACKGROUND_BATCH=0

# --- Intelligence Mirror: Form 13F holdings ----------------------------------------
# On by default when SEC_USER_AGENT is set; 0 switches ingestion off. Comma-separated manager CIKs
# (names always come from EDGAR; a CIK without 13F-HR filings is skipped). Empty = built-in list.
INSIDIR_13F_INGEST=1
INSIDIR_13F_MANAGER_CIKS=

# --- Internal cost dashboard (/admin-costs.html) ------------------------------------
# A long random token (32+ characters) and/or signed-in accounts allowed to read it
INSIDIR_ADMIN_TOKEN=
INSIDIR_ADMIN_EMAILS=
# Optional monthly hosting cost, shown as operator-entered (Railway billing is not read)
INSIDIR_INFRA_MONTHLY_USD=
# Explicit legal clearance needed before enabling House financial disclosure ingestion
INSIDIR_HOUSE_DISCLOSURES_APPROVED=0
# Official or authorized social accounts: verified Bluesky handles, comma-separated
INSIDIR_BLUESKY_HANDLES=

# --- Account security, email, alerts, explanations (docs/OPERATIONS.md) --------------
# Admin routes need BOTH the token and a one-time code from an authenticator app; without the
# TOTP secret every admin route is closed. Generate the secret with the command in OPERATIONS.md.
INSIDIR_ADMIN_TOKEN=
INSIDIR_ADMIN_TOTP_SECRET=
# Email: postmark in production (log = print to console, local development only). Nothing is sent
# until a provider is configured; messages wait in the outbox.
INSIDIR_EMAIL_PROVIDER=
POSTMARK_SERVER_TOKEN=
INSIDIR_EMAIL_FROM=
INSIDIR_EMAIL_REPLY_TO=hello@aethric.llc
INSIDIR_EMAIL_WEBHOOK_SECRET=
# 32+ random characters: signs one-click unsubscribe links. Alert emails are not sent without it.
INSIDIR_APP_SECRET=
# Business postal address for alert-email footers.
INSIDIR_POSTAL_ADDRESS=
# AI explanations of filings: OFF until counsel has reviewed them (docs/ATTORNEY-REVIEW.md D-1).
INSIDIR_AI_EXPLANATIONS=0
ANTHROPIC_API_KEY=
INSIDIR_AI_DAILY_BUDGET_USD=5
INSIDIR_AI_PER_USER_DAILY=20
