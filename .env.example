# Required to ingest SEC filings: use a real business name and monitored contact email
SEC_USER_AGENT=Insidir Research contact@example.com
DATABASE_URL=postgresql://user:password@localhost:5432/insidir
PORT=8080
# Set origin to the actual Insidir front-end before exposing account endpoints
ALLOWED_ORIGINS=https://insidir-web-production.up.railway.app
# 1 enables automatic fifteen-minute ingestion in a single Railway service
AUTO_INGEST=0
# To allow secured manual/cron ingestion: use a long unpredictable secret
INGEST_SECRET=
# Production must use HTTPS; set to 1 behind Railway HTTPS proxy
COOKIE_SECURE=1
# Allows signup. With the hard paywall people must create an account before they can
# subscribe, so set 1 in production once Stripe billing (below) is configured.
ALLOW_SIGNUP=0
# Optional ingestion limits
SEC_MAX_FILINGS_PER_RUN=35
SEC_TIMEOUT_MS=15000
# Delayed prices on company pages (yahoo, or none to turn market data off)
MARKET_DATA_PROVIDER=yahoo

# Optional read-only SnapTrade OAuth app. Keep off until registered and tested with approved production access.
# The user links accounts in SnapTrade Personal; Insidir requests ONLY the 'read' permission.
BROKERAGE_CONNECT_ENABLED=0
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# Exact URI registered in SnapTrade OAuth Apps (HTTPS in production)
SNAPTRADE_OAUTH_REDIRECT_URI=https://your-insidir-domain.com/v1/me/brokerage/callback
# Generate a fresh 32-byte random key: openssl rand -hex 32. Never change without a rotation migration.
BROKERAGE_ENCRYPTION_KEY=

# --- Hard paywall and billing -------------------------------------------------------
# Insidir has NO free tier and NO free trial. The product (dashboard, research desk,
# companies and company reports, filings, people, watchlist, portfolio, alerts and every
# /v1 API behind them) needs a signed-in account with an active subscription
# (Stripe status active or trialing) or a complimentary email listed below.
# (Signed-in accounts without one can still delete their own saved items and revoke a
# brokerage grant.)
# With the paywall on and billing NOT configured, nobody except complimentary
# accounts can use the product, and nobody can subscribe.
#
# On unless exactly 0. INSIDIR_PAYWALL=0 opens the whole product to everyone:
# local development only, never in production.
INSIDIR_PAYWALL=1
# Owner/team accounts that use the product without paying. Comma-separated; case and
# spaces are ignored. There is no email verification, so register these accounts
# yourself BEFORE listing them (otherwise someone else could sign up with the address).
INSIDIR_COMPLIMENTARY_EMAILS=
# Stripe checkout for Insidir Pro ($39/month). Checkout and the customer portal only work
# when this is 1 AND the secret key, price ID and webhook secret are all set.
INSIDIR_BILLING_ENABLED=0
# Stripe secret API key (sk_live_... in production). Also used when a member deletes their
# account: Insidir expires the customer's open checkouts and cancels EVERY subscription that
# can still bill before deleting anything, and refuses (503) if Stripe cannot confirm it.
# Keep it set while any Stripe customer exists, or those accounts cannot be deleted.
INSIDIR_STRIPE_SECRET_KEY=
# The recurring $39/month Price (price_...). Only subscriptions to this exact Price grant access.
INSIDIR_STRIPE_PRICE_ID=
# Signing secret (whsec_...) of the webhook endpoint https://YOUR_DOMAIN/v1/billing/webhook.
# Send: checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, customer.subscription.paused, customer.subscription.resumed.
INSIDIR_STRIPE_WEBHOOK_SECRET=
# Public HTTPS origin of this site. Checkout returns to /billing.html?checkout=success
# (paid) or /subscribe.html?checkout=cancel; billing requests must come from this origin.
INSIDIR_PUBLIC_URL=https://insidir-web-production.up.railway.app

# Web Push, one long-lived VAPID pair per domain. Private key is secret; never commit it.
# Generate once: npx web-push generate-vapid-keys
INSIDIR_VAPID_PUBLIC_KEY=
INSIDIR_VAPID_PRIVATE_KEY=
INSIDIR_VAPID_SUBJECT=mailto:hello@aethric.llc
